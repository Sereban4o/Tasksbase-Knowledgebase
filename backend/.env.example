APP_NAME=Tasksbase
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

BROADCAST_DRIVER=reverb
REVERB_APP_ID=chat-app
REVERB_APP_KEY=chat-key
REVERB_APP_SECRET=chat-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tasksbase_knowledgebase
DB_USERNAME=postgres
DB_PASSWORD=secret

CACHE_STORE=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

QUEUE_CONNECTION=redis
QUEUE_RETRY_AFTER=90

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=secret
