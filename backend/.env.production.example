# ─────────────────────────────────────────────────────────────────────────────
# Production environment for Tasksbase-Knowledgebase
# Copy to backend/.env.production and fill in the secrets:
#   cp backend/.env.production.example backend/.env.production
#
# Generate APP_KEY:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=Tasksbase
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://CHANGE_ME_HOST

# Disable public self-registration in production (users are created in admin)
ALLOW_REGISTRATION=false

LOG_CHANNEL=stack
LOG_LEVEL=error

# ─── Database ────────────────────────────────────────────────────────────────
# POSTGRES_*  -> used by the postgres container
# DB_*        -> used by Laravel (must match POSTGRES_*)
POSTGRES_DB=tasksbase_knowledgebase
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tasksbase_knowledgebase
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ─── Cache / Session / Queue ─────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ─── Broadcasting (Laravel Reverb) ───────────────────────────────────────────
BROADCAST_DRIVER=reverb
REVERB_APP_ID=chat-app
# Keep in sync with the nginx image build arg (VITE_REVERB_KEY).
REVERB_APP_KEY=chat-key
REVERB_APP_SECRET=CHANGE_ME_REVERB_SECRET
# Internal host: the app publishes events to the reverb container.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# ─── Sanctum / CORS ──────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=CHANGE_ME_HOST
CORS_ALLOWED_ORIGINS=http://CHANGE_ME_HOST

# ─── Search (optional) ───────────────────────────────────────────────────────
MEILISEARCH_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=CHANGE_ME_MEILI_KEY
MEILI_NO_ANALYTICS=true

# ─── Push via ntfy (Firebase-free) ──────────────────────────────────────────
# Internal URL used by the backend to publish push messages
NTFY_URL=http://ntfy:80
NTFY_TOPIC_PREFIX=tasksbase-user-
# NTFY_TOKEN=CHANGE_ME_NTFY_TOKEN
