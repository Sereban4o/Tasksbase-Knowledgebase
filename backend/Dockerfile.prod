FROM php:8.5-fpm

# ── System dependencies + PHP extensions ─────────────────────────────────────
RUN apt-get update && apt-get install -y \
    libpq-dev \
    libonig-dev \
    libzip-dev \
    zip \
    unzip \
    git \
    curl \
    libpng-dev \
    && docker-php-ext-install pdo_pgsql mbstring zip exif pcntl bcmath \
    && docker-php-ext-install gd \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Redis extension
RUN pecl install redis && docker-php-ext-enable redis

# Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# PHP-FPM + OPcache config
COPY docker.conf /usr/local/etc/php-fpm.d/docker.conf
COPY docker/opcache.ini /usr/local/etc/php/conf.d/zz-opcache.ini

WORKDIR /var/www/html

RUN mkdir -p /var/run/php && chown www-data:www-data /var/run/php

# Application code
COPY . .

# Public storage symlink
RUN ln -sfn /var/www/html/storage/app/public /var/www/html/public/storage

# Production Composer install (no dev dependencies)
RUN composer install --no-interaction --no-dev --optimize-autoloader --no-plugins --no-scripts --prefer-dist

# Entrypoint (normalize CRLF, make executable)
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint.sh && chmod +x /usr/local/bin/entrypoint.sh

# Ensure runtime directories exist (repo may omit empty storage dirs) and set permissions
RUN mkdir -p \
        storage/app/public \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/testing \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && ln -sfn /var/www/html/storage/app/public /var/www/html/public/storage \
    && chown -R www-data:www-data storage bootstrap/cache

EXPOSE 9000

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["php-fpm"]
